  "item": [
    {
      "id": "59f2b0a9-18fa-44a3-9d57-280bd47b4992",
      "name": "Trending Topics",
      "description": {
        "content": "Get currently trending news topics from social networks",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "d7f5b2b2-cce8-49f6-bad0-849d8ef03cbc",
          "name": "Get Trending News Topics",
          "request": {
            "name": "Get Trending News Topics",
            "description": {
              "content": "Returns news topics that are currently trending on social networks. Supports filtering by Unix epoch timestamp (since parameter) to retrieve topics discovered after a specific point in time. Results include topic names, related search queries, and image thumbnails. Only available in supported markets.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "news",
                "trendingtopics"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "since",
                  "value": "<long>",
                  "description": "The UNIX epoch time (Unix timestamp) that Bing uses to select the trending topics. Bing returns trending topics that it discovered on or after the specified date and time. To use this parameter, also specify the sortBy parameter and set it to Date."
                },
                {
                  "disabled": false,
                  "key": "sortBy",
                  "value": "<string>",
                  "description": "The order to return news topics in. If using Trending News API and specifying the since query parameter, you must set this parameter to Date."
                },
                {
                  "disabled": false,
                  "key": "mkt",
                  "value": "<string>",
                  "description": "The market where the results come from. Typically the country where the user is making the request from. The market must be in the form <language>-<country/region>. For example, en-US. This parameter and the cc query parameter are mutually exclusive."
                },
                {
                  "disabled": false,
                  "key": "cc",
                  "value": "<string>",
                  "description": "A 2-character country code of the country where the results come from. If you set this parameter, you must also specify the Accept-Language header. This parameter and the mkt query parameter are mutually exclusive."
                },
                {
                  "disabled": false,
                  "key": "setLang",
                  "value": "<string>",
                  "description": "The language to use for user interface strings. You may specify the language using either a 2-letter or 4-letter code. This parameter and the Accept-Language header are mutually exclusive."
                },
                {
                  "disabled": false,
                  "key": "safeSearch",
                  "value": "Moderate",
                  "description": "Used to filter news articles for adult content. The default is Moderate."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) The subscription key that you received when you signed up for this service in Azure Portal.",
                "key": "Ocp-Apim-Subscription-Key",
                "value": "<string>"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
