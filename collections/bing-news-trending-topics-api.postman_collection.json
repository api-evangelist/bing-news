  "info": {
    "_postman_id": "c890a01b-3b17-480a-8e45-2898a27b8d48",
    "name": "Bing News Search API v7 News Category Trending Topics API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Bing News Search REST API enables developers to retrieve relevant news articles, trending topics, and category-filtered news with image thumbnails and publisher metadata. The API provides search queries against Bing's news index, returning results with titles, descriptions, URLs, publication dates, and related media content.\n\nContact Support:\n Name: Microsoft Bing Support",
      "type": "text/plain"
    }
  }
