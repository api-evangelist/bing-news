  "info": {
    "_postman_id": "8a33cedc-a51f-484b-ad47-857d6f6d52f2",
    "name": "Bing News Search API v7 News Category Trending Topics API",
    "description": "The Bing News Search REST API enables developers to retrieve relevant news articles, trending topics, and category-filtered news with image thumbnails and publisher metadata. The API provides search queries against Bing's news index, returning results with titles, descriptions, URLs, publication dates, and related media content.\n\nContact Support:\n Name: Microsoft Bing Support",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-07-28T01:13:36.000Z",
    "updatedAt": "2026-07-28T01:13:36.000Z",
    "lastUpdatedBy": "35240",
